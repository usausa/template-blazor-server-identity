@page "/Account/Manage/RenamePasskey/{Id}"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]

@using System.Buffers.Text
@using Microsoft.AspNetCore.Identity
@using Template.BlazorServer.Host.Application.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>パスキー名の設定 - Template</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">パスキー名の設定</MudText>

<MudPaper Class="manage-card pa-4">
    <EditForm Model="Input" OnValidSubmit="RenameAsync" FormName="rename-passkey" method="post">
        <DataAnnotationsValidator />
        <MudText Typo="Typo.body1" Class="mb-4">@Description</MudText>
        <div class="login-field">
            <label for="passkey-name">パスキー名</label>
            <InputText @bind-Value="Input.Name" id="passkey-name" />
            <ValidationMessage For="() => Input.Name" class="mud-error-text" />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">保存</MudButton>
    </EditForm>
</MudPaper>

@code {
    private ApplicationUser? user;

    private UserPasskeyInfo? passkey;

    private string Description =>
        passkey?.Name is { } name ? $"パスキー「{name}」の新しい名前を入力してください。" : "パスキーの名前を入力してください。";

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    public string? IdentityStatusMessage { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromForm]
    public InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        IdentityStatusMessage = null;

        // ReSharper disable once NullCoalescingConditionIsAlwaysNotNullAccordingToAPIContract
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            IdentityStatusMessage = $"Error: ユーザー '{UserManager.GetUserId(HttpContext.User)}' を読み込めませんでした。";
            RedirectManager.RedirectTo("Account/Login");
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(Id);
        }
        catch (FormatException)
        {
            RedirectToPasskeysWithStatus("Error: パスキーIDの形式が不正です。");
            return;
        }

        passkey = await UserManager.GetPasskeyAsync(user, credentialId);
        if (passkey is null)
        {
            RedirectToPasskeysWithStatus("Error: 指定されたパスキーが見つかりません。");
        }
    }

    private async Task RenameAsync()
    {
        passkey!.Name = Input.Name;
        var result = await UserManager.AddOrUpdatePasskeyAsync(user!, passkey);
        if (!result.Succeeded)
        {
            RedirectToPasskeysWithStatus("Error: パスキーを更新できませんでした。");
            return;
        }

        RedirectToPasskeysWithStatus("パスキーを更新しました。");
    }

    private void RedirectToPasskeysWithStatus(string status)
    {
        IdentityStatusMessage = status;
        RedirectManager.RedirectTo("Account/Manage/Passkeys");
    }

    public sealed class InputModel
    {
        [Required(ErrorMessage = "パスキー名を入力してください。")]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
