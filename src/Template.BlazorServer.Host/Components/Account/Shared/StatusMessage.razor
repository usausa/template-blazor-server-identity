<Condition Value="HasMessage">
    <MudAlert Severity="MessageSeverity" Class="mb-4">
        @Message
    </MudAlert>
</Condition>

@code {
    [Parameter]
    public string? Message { get; set; }

    private bool HasMessage => !String.IsNullOrEmpty(Message);

    private Severity MessageSeverity =>
        Message!.StartsWith("Error", StringComparison.Ordinal) ? Severity.Error : Severity.Success;
}
