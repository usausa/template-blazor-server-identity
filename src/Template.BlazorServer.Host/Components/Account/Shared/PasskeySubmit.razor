@using Template.BlazorServer.Host.Application.Identity

@* パスキー操作を行うフォーム連携ボタン(.NET 11 Blazor Identityテンプレート由来)。
   実処理は同名の.razor.js(カスタム要素passkey-submit)が担う *@
<button type="submit" name="__passkeySubmit" @attributes="AdditionalAttributes" formnovalidate>@ChildContent</button>
<passkey-submit
    operation="@Operation"
    name="@Name"
    email-name="@UserNameField">
</passkey-submit>

@code {
    [Parameter]
    [EditorRequired]
    public PasskeyOperation Operation { get; set; }

    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = default!;

    [Parameter]
    public string? UserNameField { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
